<!DOCTYPE html>
<html>
<head><title><%= title %></title></head>
<body>
<h1><%= title %></h1>
<% for article in articles.iter() { %><article>
  <h2><a href="<%= article.url %>"><%= article.title %></a></h2>
  <p class="meta"><%= article.author %> - <%= article.date %></p>
  <p><%= article.teaser %></p>
  <ul><% for tag in article.tags.iter() { %><li><%= tag.name %></li><% } %></ul>
</article>
<% } %></body>
</html>
