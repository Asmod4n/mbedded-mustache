 }
 
+inline constexpr size_t kTail = kEscapeSlack;
+
+constexpr bool
+fits(const Context c, const std::string_view s, const size_t room)
+{
+  if (s.empty()) return true;
+  if (escaped_size_max_in(c, s.size()) + kTail <= room) [[likely]] return true;
+  if (c == Context::html_text) return escaped_size_of(s) + kTail <= room;
+  return false;
+}
+
+constexpr size_t
+needed(const Context c, const std::string_view s)
+{
+  if (c == Context::html_text) return escaped_size_of(s) + kTail;
+  return escaped_size_max_in(c, s.size()) + kTail;
+}
+
 struct Out {
