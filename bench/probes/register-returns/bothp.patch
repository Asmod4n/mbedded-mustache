index 0000000..3599a20
--- /dev/null
+++ b/include/mustache/direct.hpp
@@ -0,0 +1,257 @@
+// A walk over the closed set of types that a data type reaches, with no function pointer. A value is a pointer to one of
+// these types, and the code of each type stands in the operation that reads it.
+#pragma once
+
+#include <array>
+#include <charconv>
+#include <concepts>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <ranges>
+#include <string>
+#include <string_view>
+#include <tuple>
+#include <type_traits>
+#include <utility>
+#include <variant>
+
+#include "containers.hpp"
+
+namespace mustache::detail::direct {
+
+using containers::falsy_like;
+using containers::is_optional_v;
+using containers::list_like;
+using containers::map_like;
+using containers::NumberText;
+using containers::number_like;
+using containers::Scalar;
+using containers::text_like;
+using containers::variant_base;
+using containers::variant_like;
+using mustache::Kind;
+
+struct unsupported {};
+
+template <class... Ts>
+struct types {};
+
+template <class A, class B>
+struct joined;
+template <class... A, class... B>
+struct joined<types<A...>, types<B...>> {
+  using type = types<A..., B...>;
+};
+
+template <class... A>
+types<A...> alternatives_of(const std::variant<A...> &);
+
+template <class T>
+auto
+children_of()
+{
+  if constexpr (variant_like<T>) return decltype(alternatives_of(std::declval<const T &>())){};
+  else if constexpr (is_optional_v<T>) return types<typename T::value_type>{};
+  else if constexpr (std::same_as<T, bool> || number_like<T> || text_like<T> || falsy_like<T>) return types<>{};
+  else if constexpr (map_like<T>) return types<typename T::mapped_type>{};
+  else if constexpr (list_like<T>) return types<std::remove_cvref_t<std::ranges::range_reference_t<const T>>>{};
+  else return types<unsupported>{};
+}
+
+template <class Seen, class Todo>
+struct closure;
+template <class... S>
+struct closure<types<S...>, types<>> {
+  using type = types<S...>;
+};
+template <class... S, class T, class... R>
+struct closure<types<S...>, types<T, R...>> {
+  using type = typename std::conditional_t<
+      (std::same_as<T, S> || ...), closure<types<S...>, types<R...>>,
+      closure<types<S..., T>, typename joined<types<R...>, decltype(children_of<T>())>::type>>::type;
+};
+
+template <class T, class List>
+struct holds;
+template <class T, class... Ts>
+struct holds<T, types<Ts...>> : std::bool_constant<(std::same_as<T, Ts> || ...)> {};
+
+template <class T>
+inline constexpr bool held_v = !variant_like<T> && !is_optional_v<T> && !std::same_as<T, unsupported>;
+
+template <class In, class Out = types<>>
+struct held_of;
+template <class Out>
+struct held_of<types<>, Out> {
+  using type = Out;
+};
+template <class T, class... R, class... O>
+struct held_of<types<T, R...>, types<O...>> {
+  using type = typename held_of<types<R...>, std::conditional_t<held_v<T>, types<O..., T>, types<O...>>>::type;
+};
+
+template <class T>
+using closure_of = typename closure<types<>, types<T>>::type;
+
+template <class T>
+inline constexpr bool walkable = !holds<unsupported, closure_of<T>>::value;
+
+template <class T, class... Ts>
+inline constexpr uint32_t index_in = []() {
+  constexpr std::array<bool, sizeof...(Ts)> same = {std::same_as<T, Ts>...};
+  return (uint32_t)std::distance(same.begin(), std::ranges::find(same, true));
+}();
+
+template <class T>
+Kind
+kind_held(const T &v)
+{
+  if constexpr (std::same_as<T, bool>) return v ? Kind::truthy : Kind::falsy;
+  else if constexpr (number_like<T> || text_like<T>) return Kind::text;
+  else if constexpr (falsy_like<T>) return Kind::falsy;
+  else if constexpr (map_like<T>) return v.empty() ? Kind::falsy : Kind::map;
+  else {
+    static_assert(list_like<T>, "a value is text, a number, a bool, an optional, a variant, a map or a list");
+    return Kind::list;
+  }
+}
+
+template <class T>
+Scalar
+scalar_held(const T &v, const NumberText text)
+{
+  if constexpr (std::same_as<T, bool>) {
+    return {v ? Kind::truthy : Kind::falsy, {}};
+  }
+  else if constexpr (number_like<T>) {
+    const std::to_chars_result r = std::to_chars(text.data(), std::to_address(text.end()), v);
+    return {Kind::text, {text.data(), r.ptr}};
+  }
+  else if constexpr (text_like<T>) {
+    return {Kind::text, std::string_view(v)};
+  }
+  else if constexpr (falsy_like<T>) {
+    return {Kind::falsy, {}};
+  }
+  else if constexpr (map_like<T>) {
+    return {v.empty() ? Kind::falsy : Kind::map, {}};
+  }
+  else {
+    static_assert(list_like<T>, "a value is text, a number, a bool, an optional, a variant, a map or a list");
+    return {Kind::list, {}};
+  }
+}
+
+template <class T>
+size_t
+size_held(const T &v)
+{
+  if constexpr (list_like<T>) return (size_t)std::ranges::size(v);
+  else return 0;
+}
+
+template <class... Es>
+struct Policy {
+  using Value = std::variant<std::monostate, const Es *...>;
+
+  template <class X>
+  static Value of(const X &x)
+  {
+    if constexpr (variant_like<X>) return std::visit([](const auto &a) { return of(a); }, variant_base(x));
+    else if constexpr (is_optional_v<X>) return x ? of(*x) : Value{};
+    else return Value(std::in_place_type<const X *>, std::addressof(x));
+  }
+
+  template <class R, class F>
+  static R apply(const Value &v, const F &f, const R &absent)
+  {
+    return std::visit(
+        [&f, &absent](auto p) -> R {
+          if constexpr (std::same_as<decltype(p), std::monostate>) return absent;
+          else return f(*p);
+        },
+        v);
+  }
+};
+
+template <class Policy>
+struct Access {
+  using Value = typename Policy::Value;
+
+  template <class X>
+  static Value of(const X &x)
+  {
+    return Policy::of(x);
+  }
+
+  static Kind kind_of(const Value v)
+  {
+    return Policy::template apply<Kind>(v, [](const auto &x) -> Kind { return kind_held(x); }, Kind::falsy);
+  }
+
+  static Scalar scalar_of(const Value v, const NumberText text)
+  {
+    return Policy::template apply<Scalar>(v, [text](const auto &x) -> Scalar { return scalar_held(x, text); },
+                                          Scalar{Kind::falsy, {}});
+  }
+
+  static size_t size_of(const Value v)
+  {
+    return Policy::template apply<size_t>(v, [](const auto &x) -> size_t { return size_held(x); }, size_t{0});
+  }
+
+  static Value element(const Value v, const size_t i)
+  {
+    return Policy::template apply<Value>(
+        v,
+        [v, i](const auto &x) -> Value {
+          if constexpr (list_like<std::remove_cvref_t<decltype(x)>>) {
+            return Policy::of(*std::ranges::next(std::ranges::begin(x), (std::ptrdiff_t)i));
+          }
+          else {
+            return v;
+          }
+        },
+        Value{});
+  }
+
+  static Value find(const Value v, const std::string &key)
+  {
+    return Policy::template apply<Value>(
+        v,
+        [&key](const auto &x) -> Value {
+          if constexpr (map_like<std::remove_cvref_t<decltype(x)>>) {
+            const auto it = x.find(key);
+            if (it == x.end()) return Value{};
+            return Policy::of(it->second);
+          }
+          else {
+            return Value{};
+          }
+        },
+        Value{});
+  }
+
+  static bool value_is_absent(const Value v) { return std::holds_alternative<std::monostate>(v); }
+
+  template <class Program, class Stack>
+  static std::optional<Value> bound(const Program &, uint32_t, const Stack &, int)
+  {
+    return std::nullopt;
+  }
+};
+
+template <class List>
+struct access_over;
+template <class... Es>
+struct access_over<types<Es...>> {
+  using type = Access<Policy<Es...>>;
+};
+
+template <class T>
+using AccessFor = typename access_over<typename held_of<closure_of<T>>::type>::type;
+
+}
